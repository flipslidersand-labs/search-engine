# 検索エンジン
SEARCH_DB=search.db

# Ollama (Phase 1 RAG)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Qdrant ベクトルストア (Phase 2)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=search-engine-docs
QDRANT_VECTOR_SIZE=768

# Embedding Service (Phase 3)
EMBEDDING_URL=http://localhost:9092
EMBEDDING_COLLECTION=search-engine
EMBEDDING_API_KEY=

# API 認証 (未設定 = 全認証エンドポイントが 401。/health・/metrics は無認証なので公開しないこと)
API_KEY=
# API_KEY なしで動かす場合のみ 1 (ローカル開発専用)
ALLOW_NO_AUTH=

# デプロイ先
DEPLOY_HOST=
DEPLOY_USER=dev-nodee
