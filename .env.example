# 検索エンジン
SEARCH_DB=search.db

# Ollama (Phase 1 RAG)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Qdrant ベクトルストア (Phase 2)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=search-engine-docs
QDRANT_VECTOR_SIZE=768

# Embedding Service (Phase 3)
EMBEDDING_URL=http://localhost:9092
EMBEDDING_COLLECTION=search-engine
EMBEDDING_API_KEY=

# API 認証 (未設定 = 全認証エンドポイントが 401。/health・/metrics は無認証なので公開しないこと)
API_KEY=
# API_KEY なしで動かす場合のみ 1 (ローカル開発専用)
ALLOW_NO_AUTH=

# /index で読み込みを許可するディレクトリ(必須。未設定だと /index は 403)
# 複数指定は ":" 区切り 例: ./sample_docs:/data/docs
# docker compose 利用時はこの値を使わず /data 固定(docker-compose.yml)。文書は /data の volume に置く
ALLOWED_INDEX_DIRS=./sample_docs

# schema_gen API 用 DB パス
SCHEMA_DB=schemas.db

# ollama_url 上書きを許可するホスト(カンマ区切り。未設定 = 上書き禁止)
ALLOWED_OLLAMA_HOSTS=

# コンテキスト付与インデックス(1/true 等で有効)
SEARCH_ENGINE_CONTEXTUAL_PREFIX=

# Discord 通知(任意)
DISCORD_WEBHOOK_COMPLETION=
DISCORD_WEBHOOK_ERRORS=

# Google Sheets 連携(任意。サービスアカウント JSON のパス)
GOOGLE_APPLICATION_CREDENTIALS=

# デプロイ先
DEPLOY_HOST=
DEPLOY_USER=dev-nodee
